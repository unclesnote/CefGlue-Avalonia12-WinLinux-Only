{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-demo-avalonia",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CefGlue.Demo.Avalonia/CefGlue.Demo.Avalonia.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean-demo-avalonia",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/CefGlue.Demo.Avalonia/CefGlue.Demo.Avalonia.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64"
      ],
      "problemMatcher": []
    },
    {
      "label": "rebuild-demo-avalonia",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CefGlue.Demo.Avalonia/CefGlue.Demo.Avalonia.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64",
        "--no-incremental",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean-build-demo-avalonia",
      "dependsOrder": "sequence",
      "dependsOn": [
        "clean-demo-avalonia",
        "rebuild-demo-avalonia"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "pack-nuget-release",
      "detail": "Rebuild CefGlue.Common and CefGlue.Avalonia (Release, x64) into Nuget/output (Windows + Linux only)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CefGlue.Avalonia/CefGlue.Avalonia.csproj",
        "-c",
        "Release",
        "-p:Platform=x64",
        "--no-incremental",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
